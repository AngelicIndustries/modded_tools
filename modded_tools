#!/bin/bash

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Non-interactive commands must run before desktop probing, venv setup or menus.
if (( $# )); then
  case "$1" in
    --deobf|--deobf-1.7.10)
      shift
      exec python3 "$SCRIPT_DIR/bin/deobfuscate_mod.py" "$@"
      ;;
    -h|--help)
      echo "Usage: modded_tools [--deobf JAR [-o OUTPUT] [--mappings-dir DIR] [--force]]"
      echo "Without arguments, open the interactive menu."
      echo "Use --deobf --help for Minecraft 1.7.10 deobfuscation options."
      exit 0
      ;;
    *)
      echo "Unknown argument: $1 (use --help)" >&2
      exit 2
      ;;
  esac
fi

# Remember where this launcher was invoked. If "Run Client" is selected, the
# value is inherited by Minecraft so Hyprland can place its window beside the
# terminal that launched it, even if another workspace is active by then.
launch_workspace=''
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  launch_workspace=$(hyprctl --instance 0 activeworkspace -j 2>/dev/null |
    jq -r 'if .id > 0 then .id else empty end' 2>/dev/null || true)
fi

source "$SCRIPT_DIR/bin/common.sh"
source "$SCRIPT_DIR/venv/bin/activate"

echo "▖  ▖   ▌ ▌   ▌  ▄▖    ▜   "
echo "▛▖▞▌▛▌▛▌▛▌█▌▛▌  ▐ ▛▌▛▌▐ ▛▘"
echo "▌▝ ▌▙▌▙▌▙▌▙▖▙▌  ▐ ▙▌▙▌▐▖▄▌"
echo "by jack"
echo "Select one option using up/down keys and enter to confirm:"
echo

scripts=(
    "$SCRIPT_DIR/bin/build.sh"
    "$SCRIPT_DIR/bin/runclient.sh"
    "$SCRIPT_DIR/bin/runserver.sh"
    "$SCRIPT_DIR/bin/spotless.sh"
    "$SCRIPT_DIR/bin/invoke_langmanager.sh"
    "$SCRIPT_DIR/bin/publish_to_maven.sh"
    "$SCRIPT_DIR/bin/transform_readme.py"
    "$SCRIPT_DIR/bin/update_forge_readme.sh"
    "$SCRIPT_DIR/bin/update_modrinth_readme.sh"
    "$SCRIPT_DIR/bin/update_67minecraft_readme.sh"
    "$SCRIPT_DIR/bin/update_buildscript.sh"
    "$SCRIPT_DIR/bin/check_dependency_updates.sh"
    "$SCRIPT_DIR/bin/setup_github_credentials.sh"
    "$SCRIPT_DIR/bin/deploy_github_secrets.py"
    "$SCRIPT_DIR/bin/deploy_to_server.sh"
    "$SCRIPT_DIR/bin/deploy_to_local.sh"
)
options=(
    "Build Mod"
    "Run Client"
    "Run Server"
    "Apply Spotless"
    "Apply LangManager"
    "Publish to Maven"
    "Transform Readme"
    "Update Curse Readme"
    "Update Modrinth Readme"
    "Update 67Minecraft Readme"
    "Update Buildscript"
    "Check Dependencies For Updates"
    "Setup GitHub Credentials (Folder)"
    "Deploy GitHub Secrets + Variables"
    "Deploy To Server"
    "Deploy To Local"
)

select_option "${options[@]}"
choice=$?

if [[ $choice -eq 1 && $launch_workspace =~ ^[0-9]+$ ]]; then
  export MODDED_TOOLS_WORKSPACE="$launch_workspace"
fi

${scripts[$choice]}
